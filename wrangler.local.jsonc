{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ugcweb-local-verification",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "COMMERCE_DB",
      "database_name": "ugcweb-commerce-local-verification",
      "database_id": "00000000-0000-4000-8000-000000000001"
    },
    {
      "binding": "SEARCH_DB",
      "database_name": "ugcweb-search-local-verification",
      "database_id": "00000000-0000-4000-8000-000000000002"
    },
    {
      "binding": "CREATOR_DB",
      "database_name": "partnerlinks-creator-identity-local-verification",
      "database_id": "00000000-0000-4000-8000-000000000003"
    },
    {
      "binding": "CREATOR_EVIDENCE_DB",
      "database_name": "partnerlinks-creator-evidence-local-verification",
      "database_id": "00000000-0000-4000-8000-000000000004"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ugcweb",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "partnerlinks.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.partnerlinks.ai",
      "custom_domain": true
    },
    {
      "pattern": "partnerlinks.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.partnerlinks.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMERCE_DB",
      "database_name": "ugcweb-commerce",
      "database_id": "37fabe92-0dd8-43fd-a839-cde33679316b",
      "remote": true
    },
    {
      "binding": "SEARCH_DB",
      "database_name": "ugcweb-search",
      "database_id": "fdd85d9f-797b-4875-99c6-dcaf98b71769",
      "remote": true
    },
    {
      "binding": "CREATOR_DB",
      "database_name": "partnerlinks-creator-identity-v1",
      "database_id": "a3efd91a-8379-4a43-b2d7-aef0b830df7b",
      "remote": true
    },
    {
      "binding": "CREATOR_EVIDENCE_DB",
      "database_name": "partnerlinks-creator-evidence-v1",
      "database_id": "3bfa36dc-c9fd-4903-a8d4-fec3074dccc5",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CREATOR_AVATAR_ARCHIVE",
      "bucket_name": "ugcweb-tiktok-archive"
    }
  ]
}
